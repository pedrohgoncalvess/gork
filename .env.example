MAINTENANCE= # Optional
MAINTENANCE_NUMBER= # Optional
ENV=dev

PG_HOST=gork_postgres
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=admin
PG_NAME=postgres

MINIO_ENDPOINT=s3-minio:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

EVOLUTION_INSTANCE_KEY=
EVOLUTION_INSTANCE_NAME=Gork
EVOLUTION_API_KEY=
EVOLUTION_API=http://evolution_api:8080
EVOLUTION_INSTANCE_NUMBER= # Whatsapp number with country code and without extra 9. Ex: 553192793203

OPENROUTER_KEY=
NINJA_KEY=

GOFILE_KEY=

# Optional Netscape-format cookie file used to download Instagram reels.
# In Docker, mount the file and set this to its path inside the container.
INSTAGRAM_COOKIES_FILE=
PG_POOL_SIZE=3
PG_MAX_OVERFLOW=5
