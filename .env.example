MAINTENANCE= # Optional
MAINTENANCE_NUMBER= # Optional
ENV=dev

PG_HOST=gork_postgres
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=admin
PG_NAME=postgres

MINIO_ENDPOINT=s3-minio:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY= # Long random API key, shared with the WAHA container
WAHA_SESSION=default
WAHA_WEBHOOK_TOKEN= # Separate long random secret for incoming webhooks
WHATSAPP_INSTANCE_NUMBER= # Keep the same bot number to preserve existing history/identity
WAHA_PORT=3002
WAHA_WEBHOOK_URL=http://webhook_fastapi:9001/webhook/waha
# Administration panel: same FastAPI service at /admin.
ADMIN_PASSWORD= # Set a long, unique password to enable the panel
ADMIN_SESSION_SECRET= # Separate random signing key for login sessions
# Same pinned GOWS image as ../orbia. Override for another architecture/version.
# WAHA_IMAGE=devlikeapro/waha:gows-arm-2026.9.1

OPENROUTER_KEY=
NINJA_KEY=

GOFILE_KEY=

# Optional Netscape-format cookie file used to download Instagram reels.
# In Docker, mount the file and set this to its path inside the container.
INSTAGRAM_COOKIES_FILE=
PG_POOL_SIZE=3
PG_MAX_OVERFLOW=5
